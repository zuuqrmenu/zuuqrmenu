# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/zuulab-qr

# JWT Secret (generate a secure random string for production)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Seed credentials (required only when running npm run seed)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_RESTAURANT_EMAIL=
SEED_RESTAURANT_PASSWORD=

# CORS
CLIENT_URL=http://localhost:5174

# Cookie Security
COOKIE_SECRET=your-cookie-secret-change-this-in-production

# Cloudinary Product Images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (server-side only)
FIREBASE_PROJECT_ID=zuuqrmenu-7c02b
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ZuuAI (Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ZuuAI (NVIDIA API - Google Gemma 4)
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it
# Optional model override when testing NVIDIA directly
# NVIDIA_MODEL=z-ai/glm-5.3-flash

# PayTR iFrame API (Mağaza Paneli > Bilgi > Mağaza Bilgileri)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test modu (gerçek çekim yapılmaz), canlıya geçerken 0 yapın
PAYTR_TEST_MODE=1
# 1 = taksit kapalı, 0 = açık
PAYTR_NO_INSTALLMENT=1
PAYTR_MAX_INSTALLMENT=0
# Ödeme sonrası kullanıcının döneceği panel adresi
SITE_URL=https://www.zuuqrmenu.com
